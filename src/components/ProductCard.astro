---
import type { Product } from '../data/products';
import { productHref } from '../data/products';

// Minimal product tile for the category listing pages: group packshot + name +
// one-line summary + "View product" link. The bulk of the information lives on
// each product's individual page (/product/[slug]). Image sizing is baked in
// (fixed height + object-contain) so the SA "tiny cards" bug can't recur.
interface Props {
  product: Product;
  /** Override the pack image (e.g. the EUA-labelled pack on /products/eua). */
  image?: string;
  imageAlt?: string;
  /** Heading level for the product name (default h3). */
  headingLevel?: 2 | 3;
}
const { product, image, imageAlt, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
const imgSrc = image ?? product.image;
const imgAlt = imageAlt ?? product.imageAlt;
const href = productHref(product);
---
<a href={href}
   class="group flex flex-col overflow-hidden rounded-[var(--radius-card)] border border-border-grey bg-white transition-all duration-200 hover:-translate-y-0.5 hover:border-f10-blue hover:shadow-[0_6px_14px_rgba(14,119,188,0.14)]">
  <div class="flex h-56 w-full items-center justify-center overflow-hidden bg-soft-grey p-4">
    <img src={imgSrc} alt={imgAlt} loading="lazy" decoding="async"
         class="h-full w-auto object-contain transition-transform duration-300 group-hover:scale-[1.03]" />
  </div>
  <div class="flex flex-1 flex-col gap-2 p-5">
    <Heading class="text-lg font-extrabold leading-tight text-charcoal group-hover:text-f10-blue">{product.name}</Heading>

    {product.description ? (
      <p class="text-sm leading-relaxed text-medium-grey">{product.description}</p>
    ) : (
      <p class="text-xs italic text-medium-grey">[CONTENT SLOT: product summary — supplied copy pending]</p>
    )}

    <span class="mt-auto pt-1 text-sm font-bold text-f10-blue">View product <span aria-hidden="true">›</span></span>
  </div>
</a>
