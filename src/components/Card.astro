---
// Signature horizontal image-card (DESIGN.md). The image is forced to
// width:100% + fixed height + object-cover, baked in so the SA "tiny cards"
// bug cannot recur. Hover = blue border + slight lift + soft shadow.
interface Props {
  title: string;
  href: string;
  image?: string;
  imageAlt?: string;
  description?: string;
  /** 'contain' suits pack-shots (whole product shown); 'cover' fills the frame. */
  fit?: 'cover' | 'contain';
  /** eager-load for near-the-fold cards to avoid pop-in. */
  eager?: boolean;
}
const { title, href, image, imageAlt = '', description, fit = 'cover', eager = false } = Astro.props;
const contain = fit === 'contain';
---
<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-[var(--radius-card)] border border-border-grey bg-white transition-all duration-200 hover:-translate-y-0.5 hover:border-f10-blue hover:shadow-[0_6px_14px_rgba(14,119,188,0.14)]"
>
  <div class:list={["w-full overflow-hidden", contain ? "h-56 bg-soft-grey p-4" : "h-44 bg-light-blue"]}>
    {image ? (
      <img src={image} alt={imageAlt} loading={eager ? "eager" : "lazy"} decoding="async"
           class:list={["h-full w-full transition-transform duration-300 group-hover:scale-[1.03]", contain ? "object-contain" : "object-cover"]} />
    ) : (
      <div class="dots-light flex h-full w-full items-center justify-center text-sm font-semibold text-medium-grey">
        [IMAGE: {title}]
      </div>
    )}
  </div>
  <div class="flex flex-1 flex-col gap-1 p-5">
    <h3 class="text-lg font-extrabold text-charcoal group-hover:text-f10-blue">{title}</h3>
    {description && <p class="text-sm leading-relaxed text-medium-grey">{description}</p>}
  </div>
</a>
