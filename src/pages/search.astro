---
import BaseLayout from '../layouts/BaseLayout.astro';

// SEARCH — client-side full-text search via Pagefind. Pagefind indexes the
// built site (postbuild: `pagefind --site dist`) and serves its runtime from
// /pagefind/. The header search form GETs here with ?q=…; we pre-fill and run it.
// NOTE: /pagefind/ only exists after `npm run build` — in `astro dev` the page
// shows a build-required note instead of erroring.
---
<BaseLayout
  title="Search"
  description="Search the F10® US site — products, credentials, resources and reports."
>
  <Fragment slot="head">
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <meta name="robots" content="noindex" />
  </Fragment>

  <!-- Page hero -->
  <section class="dots-hero text-white">
    <div class="section-inner py-16">
      <nav aria-label="Breadcrumb" class="mb-4 text-sm text-white/80">
        <a href="/" class="hover:underline">Home</a> <span aria-hidden="true">/</span> Search
      </nav>
      <h1 class="max-w-3xl text-white text-4xl font-black leading-[1.05] sm:text-5xl">
        Search
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-white/90">
        Search across F10® products, credentials, resources and reports.
      </p>
    </div>
  </section>

  <!-- Search UI -->
  <section class="bg-white">
    <div class="section-inner py-16" data-pagefind-ignore>
      <div id="search" style="--pagefind-ui-primary:#0E77BC;--pagefind-ui-font:inherit;--pagefind-ui-border-radius:12px;"></div>
      <p id="search-fallback" class="hidden rounded-lg border border-dashed border-border-grey bg-soft-grey p-4 text-sm italic text-medium-grey">
        Search runs on the built site. Run <code>npm run build</code> then preview, or view it live once
        deployed. Meanwhile, browse the <a href="/products" class="font-semibold text-f10-blue not-italic hover:underline">product range</a>.
      </p>
    </div>
  </section>

  <script is:inline src="/pagefind/pagefind-ui.js" onerror="document.getElementById('search-fallback').classList.remove('hidden')"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (typeof PagefindUI === 'undefined') {
        document.getElementById('search-fallback').classList.remove('hidden');
        return;
      }
      new PagefindUI({ element: '#search', showSubResults: true, showImages: false });

      // Pre-fill from ?q= (the header search form submits here).
      const q = new URLSearchParams(location.search).get('q');
      if (q) {
        const tryFill = (attempt = 0) => {
          const input = document.querySelector('#search .pagefind-ui__search-input');
          if (input) {
            input.value = q;
            input.dispatchEvent(new Event('input', { bubbles: true }));
            input.focus();
          } else if (attempt < 20) {
            setTimeout(() => tryFill(attempt + 1), 50);
          }
        };
        tryFill();
      }
    });
  </script>
</BaseLayout>
