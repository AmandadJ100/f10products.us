---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import { SITE } from '../../consts';
import { products, primaryCategory, relatedProducts, type Product } from '../../data/products';

// INDIVIDUAL PRODUCT PAGE (layout mirrors the SA product page, US content only).
// No blue hero — clean breadcrumb + title header, then a pack-shot gallery and
// key facts, then the Overview (label Description + Where to Use). Every field is
// supplied by Amanda verbatim or shown as a visible placeholder; NO SA data
// (G-numbers, kill/dilution tables, calculator) is ported — REGULATORY_GUARDRAILS.md.

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

interface Props { product: Product }
const { product } = Astro.props;

const cat = primaryCategory(product);
const related = relatedProducts(product);

// EUA-primary products have a single EUA-labelled pack shot (no per-size range).
// Use it for the gallery so the page never shows the FDA-Index (MUMS) packs.
const isEuaPrimary = cat.key === 'eua';
// EUA product pages carry the "NWS" (New World Screwworm) qualifier in the
// category label (Amanda 2026-09-07) — scoped to these product pages; the
// category/hub pages keep "FDA EUA Products".
const catLabel = isEuaPrimary ? 'FDA NWS EUA Products' : cat.label;
const galleryImage = isEuaPrimary && product.imageEua ? product.imageEua : product.image;
const galleryAlt = isEuaPrimary && product.imageEuaAlt ? product.imageEuaAlt : product.imageAlt;
const galleryPacks = isEuaPrimary ? undefined : product.packs;
const hasFdaDocs = product.docs.some((d) => d.type === 'fda-index' || d.type === 'eua-fact' || d.type === 'eua-foi');
const hasOverview = Boolean(product.description || product.whereToUse);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: SITE.url + '/products' },
      { '@type': 'ListItem', position: 3, name: catLabel, item: SITE.url + cat.href },
      { '@type': 'ListItem', position: 4, name: product.name, item: SITE.url + '/product/' + product.slug },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: product.name,
    brand: { '@type': 'Brand', name: 'F10®' },
    manufacturer: { '@type': 'Organization', name: SITE.company },
    image: new URL(galleryImage, SITE.url).href,
    ...(product.description ? { description: product.description } : {}),
    ...(product.epaReg ? { productID: 'EPA:' + product.epaReg } : {}),
  },
];
---
<BaseLayout
  title={product.name}
  description={product.description ?? `${product.name} — part of the F10® US product range. Pack sizes, active ingredients and documents.`}
>
  <Fragment slot="head">
    {jsonLd.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} is:inline />)}
  </Fragment>

  <!-- Header: breadcrumb + category eyebrow + title (no hero band) -->
  <section class="border-b border-border-grey bg-white">
    <div class="section-inner py-8">
      <nav aria-label="Breadcrumb" class="mb-4 text-sm text-medium-grey">
        <a href="/" class="hover:text-f10-blue">Home</a> <span aria-hidden="true">/</span>
        <a href="/products" class="hover:text-f10-blue">Products</a> <span aria-hidden="true">/</span>
        <a href={cat.href} class="hover:text-f10-blue">{catLabel}</a> <span aria-hidden="true">/</span>
        <span class="text-charcoal">{product.name}</span>
      </nav>
      <p class="text-xs font-bold uppercase tracking-wider text-f10-blue">{catLabel}</p>
      <h1 class="mt-2 max-w-3xl text-3xl font-black leading-tight text-charcoal sm:text-4xl">{product.name}</h1>
    </div>
  </section>

  <!-- Pack-shot gallery + key facts -->
  <section class="bg-white">
    <div class="section-inner grid gap-10 py-12 md:grid-cols-2 md:items-start">
      <ProductGallery name={product.name} image={galleryImage} imageAlt={galleryAlt} packs={galleryPacks} />

      <div class="flex flex-col gap-6">
        <!-- Pack sizes -->
        {product.sizes.length > 0 && (
          <div>
            <h2 class="text-xs font-bold uppercase tracking-wider text-medium-grey">Pack sizes</h2>
            <ul class="mt-2 flex flex-wrap gap-2" aria-label="Available pack sizes">
              {product.sizes.map((s) => (
                <li class="rounded-full border border-border-grey bg-soft-grey px-3 py-1 text-sm font-semibold text-charcoal">{s}</li>
              ))}
            </ul>
          </div>
        )}

        <!-- Active ingredients -->
        {product.activeIngredients && product.activeIngredients.length > 0 && (
          <div>
            <h2 class="text-xs font-bold uppercase tracking-wider text-medium-grey">Active ingredients</h2>
            <ul class="mt-2 list-disc pl-5 text-sm text-charcoal">
              {product.activeIngredients.map((a) => <li>{a}</li>)}
            </ul>
          </div>
        )}

        <!-- Registration -->
        <div>
          <h2 class="text-xs font-bold uppercase tracking-wider text-medium-grey">Registration</h2>
          {product.epaReg && (
            <p class="mt-2 text-sm text-charcoal"><span class="font-bold">EPA Reg. No.</span> {product.epaReg}</p>
          )}
          {product.epaRegPending && (
            <p class="mt-2 text-sm italic text-medium-grey">[CONFIRM: EPA registration number]</p>
          )}
          {product.regNotRequired && (
            <p class="mt-2 text-sm text-charcoal">Not required for this product.</p>
          )}
          {!product.epaReg && !product.epaRegPending && !product.regNotRequired && hasFdaDocs && (
            <p class="mt-2 text-sm text-charcoal">US FDA — see the published documents below for the authorized pathway, species, use and conditions.</p>
          )}
        </div>

        <!-- Directions -->
        {product.directions && (
          <div>
            <h2 class="text-xs font-bold uppercase tracking-wider text-medium-grey">Directions for use</h2>
            <p class="mt-2 text-sm text-charcoal">{product.directions}</p>
          </div>
        )}

        <!-- Documents + distributor -->
        <div class="flex flex-col gap-2 border-t border-border-grey pt-5">
          {product.docs.map((d) => (
            <a href={d.href} target="_blank" rel="noopener"
               class="text-sm font-semibold text-f10-blue hover:underline">{d.label} <span aria-hidden="true">↓</span></a>
          ))}
          {product.sdsPending && (
            <span class="text-sm font-semibold text-medium-grey">Safety Data Sheet (SDS) — to follow</span>
          )}
          {product.links?.map((l) => (
            <a href={l.href} class="text-sm font-semibold text-f10-blue hover:underline">{l.label} <span aria-hidden="true">→</span></a>
          ))}
          <a href="/distributors"
             class="mt-3 inline-block w-fit rounded-lg bg-f10-blue px-6 py-3 text-sm font-bold text-white transition hover:bg-f10-blue-deep">
            Find a distributor
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview: label Description + Where to Use (Amanda-supplied, verbatim) -->
  <section class="dots-light">
    <div class="section-inner py-16">
      <div class="max-w-3xl">
        <h2 class="text-2xl font-extrabold">Overview</h2>
        {hasOverview ? (
          <div class="mt-3 flex flex-col gap-3 text-charcoal">
            {product.description && <p>{product.description}</p>}
            {product.whereToUse && <p>{product.whereToUse}</p>}
          </div>
        ) : (
          <p class="mt-3 rounded-lg border border-dashed border-border-grey bg-white p-4 text-sm italic text-medium-grey">
            [CONTENT SLOT: full product overview — supplied copy pending]
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- Related products -->
  {related.length > 0 && (
    <section class="bg-white">
      <div class="section-inner py-16">
        <h2 class="text-3xl font-extrabold">Related products</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    </section>
  )}

  <!-- Distributor CTA -->
  <section class="dots-blue text-white">
    <div class="section-inner flex flex-col items-center gap-4 py-14 text-center">
      <h2 class="text-3xl font-extrabold text-white">Looking to buy F10® in the US?</h2>
      <p class="max-w-xl text-white/90">F10® is supplied through authorized US distributors.</p>
      <a href="/distributors" class="rounded-lg bg-white px-6 py-3 text-sm font-bold text-f10-blue transition hover:bg-light-blue">
        Find a distributor
      </a>
    </div>
  </section>
</BaseLayout>
