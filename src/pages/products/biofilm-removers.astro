---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { SITE } from '../../consts';
import { productsInCategory } from '../../data/products';

// BIOFILM REMOVERS category (internal category key stays 'degreasers').
// Structure-first: factual/organisational copy only. No efficacy, spectrum,
// kill, or dilution claims, and no US registration number until Amanda
// supplies it — REGULATORY_GUARDRAILS.md. SDS links are factual safety documents.

const items = productsInCategory('degreasers');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: SITE.url + '/products' },
      { '@type': 'ListItem', position: 3, name: 'Biofilm Removers', item: SITE.url + '/products/biofilm-removers' },
    ],
  },
  ...items.map((p) => ({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: p.name,
    brand: { '@type': 'Brand', name: 'F10®' },
    manufacturer: { '@type': 'Organization', name: SITE.company },
    image: new URL(p.image, SITE.url).href,
    category: 'Biofilm remover',
  })),
];
---
<BaseLayout
  title="Biofilm Removers"
  description="The F10® biofilm remover range for the US market — biofilm removal for professional cleaning routines, with Safety Data Sheets."
>
  <Fragment slot="head">
    {jsonLd.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} is:inline />)}
  </Fragment>

  <!-- Page hero -->
  <section class="dots-hero text-white">
    <div class="section-inner py-16">
      <nav aria-label="Breadcrumb" class="mb-4 text-sm text-white/80">
        <a href="/" class="hover:underline">Home</a> <span aria-hidden="true">/</span>
        <a href="/products" class="hover:underline">Products</a> <span aria-hidden="true">/</span> Biofilm Removers
      </nav>
      <h1 class="max-w-3xl text-white text-4xl font-black leading-[1.05] sm:text-5xl">
        F10® biofilm removers
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-white/90">
        The F10® biofilm remover range for professional veterinary and biosecurity cleaning routines.
      </p>
    </div>
  </section>

  <!-- Products -->
  <section class="bg-white">
    <div class="section-inner py-16">
      <h2 class="text-3xl font-extrabold">The biofilm remover range</h2>
      <!-- This range requires no US registration (confirmed by Amanda 2026-08-03). -->
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <!-- Distributor CTA -->
  <section class="dots-blue text-white">
    <div class="section-inner flex flex-col items-center gap-4 py-14 text-center">
      <h2 class="text-3xl font-extrabold text-white">Looking to buy F10® in the US?</h2>
      <p class="max-w-xl text-white/90">F10® is supplied through authorized US distributors.</p>
      <a href="/distributors" class="rounded-lg bg-white px-6 py-3 text-sm font-bold text-f10-blue transition hover:bg-light-blue">
        Find a distributor
      </a>
    </div>
  </section>
</BaseLayout>
