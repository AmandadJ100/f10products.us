---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { SITE } from '../../consts';
import { productsInCategory } from '../../data/products';

// DISINFECTANTS category. Structure-first: factual/organisational copy only.
// No efficacy, spectrum, kill, or dilution claims — REGULATORY_GUARDRAILS.md.
// EPA status CONFIRMED (Amanda 2026-08-03): the range is EPA-registered with
// EPA-approved labels (Establishment No. 79755zaf001; product Reg. Nos. 79755-4
// F10CL, -5 F10 RTU, -6 F10SC, -8 F10SCXD — verbatim from the EPA approval docs).
// SDS links are factual safety documents.

const items = productsInCategory('disinfectants');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: SITE.url + '/products' },
      { '@type': 'ListItem', position: 3, name: 'Disinfectants', item: SITE.url + '/products/disinfectants' },
    ],
  },
  ...items.map((p) => ({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: p.name,
    brand: { '@type': 'Brand', name: 'F10®' },
    manufacturer: { '@type': 'Organization', name: SITE.company },
    image: new URL(p.image, SITE.url).href,
    category: 'Veterinary disinfectant',
  })),
];
---
<BaseLayout
  title="Disinfectants"
  description="The F10® veterinary disinfectant range for the US market — surface and environmental disinfection products, each with its Safety Data Sheet."
>
  <Fragment slot="head">
    {jsonLd.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} is:inline />)}
  </Fragment>

  <!-- Page hero -->
  <section class="dots-hero text-white">
    <div class="section-inner py-16">
      <nav aria-label="Breadcrumb" class="mb-4 text-sm text-white/80">
        <a href="/" class="hover:underline">Home</a> <span aria-hidden="true">/</span>
        <a href="/products" class="hover:underline">Products</a> <span aria-hidden="true">/</span> Disinfectants
      </nav>
      <h1 class="max-w-3xl text-white text-4xl font-black leading-[1.05] sm:text-5xl">
        F10® veterinary disinfectants
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-white/90">
        The F10® disinfectant range for surface and environmental disinfection in professional
        veterinary and biosecurity settings.
      </p>
    </div>
  </section>

  <!-- Products -->
  <section class="bg-white">
    <div class="section-inner py-16">
      <h2 class="text-3xl font-extrabold">The disinfectant range</h2>
      <p class="mt-2 max-w-2xl text-sm text-charcoal">
        The F10® veterinary disinfectant range is registered with the U.S. EPA under EPA-approved
        product labels (EPA Establishment No. 79755zaf001), and is registered for sale in 49 US
        states — every state except Hawaii.
      </p>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <!-- Distributor CTA -->
  <section class="dots-blue text-white">
    <div class="section-inner flex flex-col items-center gap-4 py-14 text-center">
      <h2 class="text-3xl font-extrabold text-white">Looking to buy F10® in the US?</h2>
      <p class="max-w-xl text-white/90">F10® is supplied through authorized US distributors.</p>
      <a href="/distributors" class="rounded-lg bg-white px-6 py-3 text-sm font-bold text-f10-blue transition hover:bg-light-blue">
        Find a distributor
      </a>
    </div>
  </section>
</BaseLayout>
