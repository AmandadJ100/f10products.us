---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, CONTACT_FORM_ID } from '../consts';

// CONTACT (SITE_PLAN.md #8). Wholesale model: purchasing goes through US
// distributors, so this page is company/general contact + a pointer to
// Distributors, plus a general enquiry form (Formspree backend).
// Regulatory: this is NOT the adverse-reaction channel — adverse events go to
// the dedicated FDA 1932a route (REGULATORY_GUARDRAILS.md); we link to it, we
// do not collect adverse events through a general form.

const formReady = Boolean(CONTACT_FORM_ID);
const formAction = formReady ? `https://formspree.io/f/${CONTACT_FORM_ID}` : '#';

// Manufacturer address (same wording as About — SEO entity consistency).
const address = 'Cnr. Leader & Hoefsmid Streets, Stormill Ext. 10, Roodepoort, 1709, South Africa';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: SITE.url + '/contact' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contact F10®',
    url: SITE.url + '/contact',
    mainEntity: {
      '@type': 'Organization',
      name: `${SITE.brand} — ${SITE.company}`,
      url: SITE.url,
      email: SITE.email,
      telephone: SITE.phone,
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: SITE.phone,
        email: SITE.email,
        contactType: 'customer service',
        areaServed: 'US',
        availableLanguage: 'English',
      },
    },
  },
];
---
<BaseLayout
  title="Contact"
  description="Contact F10® in the US — general enquiries by phone or email, and where to buy through authorized US distributors."
>
  <Fragment slot="head">
    {jsonLd.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} is:inline />)}
  </Fragment>

  <!-- Page hero -->
  <section class="dots-hero text-white">
    <div class="section-inner py-16">
      <nav aria-label="Breadcrumb" class="mb-4 text-sm text-white/80">
        <a href="/" class="hover:underline">Home</a> <span aria-hidden="true">/</span> Contact
      </nav>
      <h1 class="max-w-3xl text-white text-4xl font-black leading-[1.05] sm:text-5xl">
        Contact F10®
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-white/90">
        Questions about the F10® range, credentials or where to buy in the US? Reach us directly, or
        send a message and the team will get back to you.
      </p>
    </div>
  </section>

  <!-- Contact methods + form -->
  <section class="bg-white">
    <div class="section-inner grid gap-12 py-16 lg:grid-cols-2">

      <!-- Left: direct contact + where to buy -->
      <div>
        <h2 class="text-2xl font-extrabold">Get in touch</h2>

        <dl class="mt-6 space-y-5 text-sm">
          <div>
            <dt class="text-xs font-bold uppercase tracking-wider text-medium-grey">Phone (US, toll-free)</dt>
            <dd class="mt-1">
              <a href={`tel:${SITE.phone.replace(/[^0-9]/g, '')}`} class="text-lg font-extrabold text-f10-blue hover:underline">{SITE.phone}</a>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase tracking-wider text-medium-grey">Email</dt>
            <dd class="mt-1">
              <a href={`mailto:${SITE.email}`} class="text-lg font-extrabold text-f10-blue hover:underline">{SITE.email}</a>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase tracking-wider text-medium-grey">Manufacturer</dt>
            <dd class="mt-1 text-charcoal">{SITE.company}</dd>
            <dd class="text-medium-grey">{address}</dd>
          </div>
        </dl>

        <!-- Where to buy -->
        <div class="mt-8 rounded-[var(--radius-card)] border border-border-grey bg-soft-grey p-6">
          <h3 class="text-base font-extrabold text-charcoal">Looking to buy F10®?</h3>
          <p class="mt-2 text-sm text-medium-grey">
            F10® is supplied through authorized US distributors. See the
            <a href="/distributors" class="font-semibold text-f10-blue hover:underline">distributors page</a>
            for who to order from by product type.
          </p>
        </div>

        <!-- Adverse reaction (regulatory — link, don't collect here) -->
        <div class="mt-6 rounded-lg border border-f10-amber/40 bg-f10-amber/10 p-5 text-sm text-medium-grey">
          <p>
            <span class="font-bold text-charcoal">Reporting an adverse reaction?</span> Please use the
            dedicated <a href="/report-adverse-reaction" class="font-semibold text-f10-blue hover:underline">adverse-reaction reporting page</a>
            — not this general form.
          </p>
        </div>
      </div>

      <!-- Right: enquiry form -->
      <div>
        <h2 class="text-2xl font-extrabold">Send a message</h2>

        {!formReady && (
          <p class="mt-4 rounded-lg border border-dashed border-border-grey bg-soft-grey p-4 text-sm italic text-medium-grey">
            [Form setup pending — add the Formspree form ID in <code>consts.ts</code> to make this live.
            Meanwhile, please email <a href={`mailto:${SITE.email}`} class="font-semibold text-f10-blue not-italic hover:underline">{SITE.email}</a>.]
          </p>
        )}

        <form
          action={formAction}
          method="POST"
          class:list={['mt-6 space-y-4', !formReady && 'pointer-events-none opacity-50']}
          aria-disabled={!formReady}
        >
          <!-- Honeypot (spam trap) — real users leave this empty -->
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <input type="hidden" name="_subject" value="New enquiry — f10products.com" />

          <div>
            <label for="name" class="block text-sm font-semibold text-charcoal">Name</label>
            <input id="name" name="name" type="text" required
              class="mt-1 w-full rounded-lg border border-border-grey bg-white px-3 py-2 text-sm text-charcoal focus:border-f10-blue focus:outline-none focus:ring-2 focus:ring-f10-blue/30" />
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold text-charcoal">Email</label>
            <input id="email" name="email" type="email" required
              class="mt-1 w-full rounded-lg border border-border-grey bg-white px-3 py-2 text-sm text-charcoal focus:border-f10-blue focus:outline-none focus:ring-2 focus:ring-f10-blue/30" />
          </div>

          <div>
            <label for="organization" class="block text-sm font-semibold text-charcoal">Organization <span class="font-normal text-medium-grey">(optional)</span></label>
            <input id="organization" name="organization" type="text"
              class="mt-1 w-full rounded-lg border border-border-grey bg-white px-3 py-2 text-sm text-charcoal focus:border-f10-blue focus:outline-none focus:ring-2 focus:ring-f10-blue/30" />
          </div>

          <div>
            <label for="subject" class="block text-sm font-semibold text-charcoal">Subject</label>
            <input id="subject" name="subject" type="text" required
              class="mt-1 w-full rounded-lg border border-border-grey bg-white px-3 py-2 text-sm text-charcoal focus:border-f10-blue focus:outline-none focus:ring-2 focus:ring-f10-blue/30" />
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-charcoal">Message</label>
            <textarea id="message" name="message" rows="5" required
              class="mt-1 w-full rounded-lg border border-border-grey bg-white px-3 py-2 text-sm text-charcoal focus:border-f10-blue focus:outline-none focus:ring-2 focus:ring-f10-blue/30"></textarea>
          </div>

          <button type="submit" disabled={!formReady}
            class="rounded-lg bg-f10-blue px-6 py-3 text-sm font-bold text-white transition hover:bg-f10-blue-deep disabled:cursor-not-allowed disabled:opacity-60">
            Send message
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
