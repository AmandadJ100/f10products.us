---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

// CREDENTIALS & COMPLIANCE — the US site's biggest trust asset (SITE_PLAN.md #5).
// REGULATORY_GUARDRAILS.md governs every word here:
//  - No authored efficacy/registration claims. Documents are published in full and
//    unaltered; each card links the source document and lets it speak.
//  - TWO distinct FDA pathways with DIFFERENT authorized animals — never conflated.
//    EUA = emergency, time-limited, broad species (incl. cattle/horses).
//    FDA Index (MSAD) = routine listing, minor/exotic species only.
//  - Species shown verbatim, attributed to the source document (Amanda decision 2026-07-29).
//  - EPA establishment no. + SABS intentionally NOT shown yet (Amanda decision 2026-07-29).

// --- FDA Emergency Use Authorization (2 products) ---------------------------
const euaProducts = [
  {
    name: 'F10® Antiseptic Wound Spray with Insecticide',
    eua: 'FDA EUA No. 006672',
    authorized: 'March 10, 2026',
    factSheet: '/documents/f10-wound-spray-eua-fact-sheet.pdf',
    foi: '/documents/f10-wound-spray-eua-foi-sheet.pdf',
  },
  {
    name: 'F10® Antiseptic Barrier Ointment with Insecticide',
    eua: 'FDA EUA No. 006677',
    authorized: 'April 24, 2026',
    factSheet: '/documents/f10-barrier-ointment-eua-fact-sheet.pdf',
    foi: '/documents/f10-barrier-ointment-eua-foi-sheet.pdf',
  },
];

// Authorized animals, verbatim from the FDA EUA Fact Sheets.
const euaSpecies = [
  'Cattle',
  'Horses',
  'Minor species of hoof stock',
  'Raptors & other wild birds',
  'Pet birds',
  'Captive & captured wild, exotic & zoo mammals',
];

// --- FDA Index — Minor Species (MSAD), 4 FOI Summaries ---------------------
const indexProducts = [
  { name: 'F10® brand Antiseptic Solution', file: 'MIF 900-007',
    doc: '/documents/f10-antiseptic-solution-fda-index-foi.pdf' },
  { name: 'F10® brand Antiseptic Barrier Ointment', file: 'MIF 900-009',
    doc: '/documents/f10-barrier-ointment-fda-index-foi.pdf' },
  { name: 'F10® brand Antiseptic Wound Spray with Insecticide', file: 'MIF 900-010',
    doc: '/documents/f10-wound-spray-wi-fda-index-foi.pdf' },
  { name: 'F10® brand Antiseptic Barrier Ointment with Insecticide', file: 'MIF 900-011',
    doc: '/documents/f10-barrier-ointment-wi-fda-index-foi.pdf' },
];

// Species line shared by all four Index products, verbatim from the FOI Summaries.
const indexSpecies = 'Raptors, pet birds, captive small mammals, captive reptiles, and captive exotic/zoo mammals';

// --- Quality & manufacturing -----------------------------------------------
const qualityDocs = [
  { name: 'GMP compliance', meta: 'Good Manufacturing Practice — certificate of compliance',
    doc: '/documents/f10-gmp-compliance.pdf' },
  { name: 'ISO 9001 : 2015', meta: 'Quality Management System — certificate no. FM 755744',
    doc: '/documents/f10-iso-9001-certificate.pdf' },
];

// --- FAQ (GEO). Factual / definitional only — no product efficacy claims. ---
const faqs = [
  {
    q: 'Are F10® products FDA-approved?',
    a: 'Two F10® products carry an FDA Emergency Use Authorization (EUA) for New World screwworm, and four F10® treatment products are listed on the FDA Index of Legally Marketed Unapproved New Animal Drugs for Minor Species. An EUA and an Index listing are specific FDA regulatory pathways; they are not the same as full FDA new-animal-drug approval. Every document is published in full below.',
  },
  {
    q: 'What is the FDA Index for Minor Species?',
    a: 'The FDA Index of Legally Marketed Unapproved New Animal Drugs for Minor Species lets certain drugs be legally marketed for minor (non-major, non-food-producing) species. F10® listings cover raptors, pet birds, captive small mammals, captive reptiles, and captive exotic/zoo mammals, and are prohibited in dogs, cats, horses, and food-producing species. Each listing’s conditions are set out in its FOI Summary.',
  },
  {
    q: 'What is an FDA Emergency Use Authorization (EUA)?',
    a: 'An EUA is an FDA authorization for the emergency use of a product during a declared emergency. The F10® EUAs cover the prevention and treatment of New World screwworm (Cochliomyia hominivorax) myiasis and are authorized only for the duration of the emergency declaration, unless revoked sooner. The authorized animals and conditions are stated in each Fact Sheet.',
  },
];

// Breadcrumb + FAQ structured data (SEO_GEO_STRATEGY.md). Facts only.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Credentials', item: SITE.url + '/credentials' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<BaseLayout
  title="Credentials & Compliance"
  description="F10® US credentials and compliance documents — FDA Emergency Use Authorizations, FDA Index (Minor Species) listings, GMP and ISO 9001 — each published in full and unaltered."
>
  <Fragment slot="head">
    {jsonLd.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} is:inline />)}
  </Fragment>

  <!-- Page hero -->
  <section class="dots-hero text-white">
    <div class="section-inner py-16">
      <nav aria-label="Breadcrumb" class="mb-4 text-sm text-white/80">
        <a href="/" class="hover:underline">Home</a> <span aria-hidden="true">/</span> Credentials
      </nav>
      <h1 class="max-w-3xl text-white text-4xl font-black leading-[1.05] sm:text-5xl">
        Credentials &amp; compliance
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-white/90">
        Every credential and regulatory document below is published in full and unaltered. Read each
        document for the authorized animals, use, conditions, and limitations.
      </p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {['FDA Emergency Use Authorized', 'FDA Index (Minor Species)', 'GMP compliance', 'ISO 9001'].map((c) => (
          <li class="rounded-full bg-white/15 px-3 py-1 text-sm font-semibold text-white">{c}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FDA Emergency Use Authorization -->
  <section id="fda-eua" class="bg-white scroll-mt-8">
    <div class="section-inner py-16">
      <div class="max-w-3xl">
        <span class="inline-block rounded-full bg-f10-blue/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-f10-blue">
          FDA Emergency Use Authorization
        </span>
        <h2 class="mt-3 text-3xl font-extrabold">FDA Emergency Use Authorized products</h2>
        <p class="mt-3 text-charcoal">
          Two F10® products are authorized by the U.S. FDA under Emergency Use Authorization for the
          prevention and treatment of infestations caused by New World screwworm
          (<em>Cochliomyia hominivorax</em>) larvae — myiasis. Per the FDA Fact Sheets, the authorized
          animals are:
        </p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {euaSpecies.map((s) => (
            <li class="rounded-full border border-border-grey bg-white px-3 py-1 text-sm font-semibold text-charcoal">{s}</li>
          ))}
        </ul>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {euaProducts.map((p) => (
          <div class="rounded-[var(--radius-card)] border border-border-grey bg-white p-6">
            <h3 class="text-lg font-extrabold leading-tight text-charcoal">{p.name}</h3>
            <p class="mt-1 text-sm font-semibold text-f10-blue">{p.eua}</p>
            <p class="mt-1 text-xs text-medium-grey">Original EUA authorized {p.authorized}</p>
            <div class="mt-4 flex flex-col gap-1">
              <a href={p.factSheet} target="_blank" rel="noopener" class="text-sm font-semibold text-f10-red hover:underline">Read the FDA Fact Sheet →</a>
              <a href={p.foi} target="_blank" rel="noopener" class="text-sm font-semibold text-f10-blue hover:underline">FOI Summary →</a>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-8 rounded-lg border border-f10-amber/40 bg-f10-amber/10 p-5 text-sm text-medium-grey">
        <p><span class="font-bold text-charcoal">Important:</span> It is a violation of Federal law to use these
        products other than as directed in the FDA Fact Sheet. An Emergency Use Authorization is authorized only
        for the duration of the emergency declaration, unless revoked sooner. Read each Fact Sheet for the
        authorized animals, use, conditions, and limitations.</p>
      </div>
    </div>
  </section>

  <!-- FDA Index — Minor Species -->
  <section class="dots-light">
    <div class="section-inner py-16">
      <div class="max-w-3xl">
        <span class="inline-block rounded-full bg-f10-blue/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-f10-blue">
          FDA Index — Minor Species
        </span>
        <h2 class="mt-3 text-3xl font-extrabold">FDA Index of Legally Marketed Unapproved New Animal Drugs for Minor Species</h2>
        <p class="mt-3 text-charcoal">
          Four F10® treatment products are listed on the FDA Index for Minor Species. Per each FOI Summary,
          they are indexed for use in: <span class="font-semibold">{indexSpecies}</span>. Use is prohibited in
          dogs, cats, horses, and food-producing species.
        </p>
        <p class="mt-3 rounded-lg border border-border-grey bg-white p-4 text-sm text-medium-grey">
          <span class="font-bold text-charcoal">Note:</span> the FDA Index listing and the FDA Emergency Use
          Authorization are two different FDA pathways with different authorized animals. The Index listings above
          cover minor/exotic species only; the EUA additionally covers cattle, horses, and hoof stock for the
          screwworm emergency. Each document states its own authorized animals.
        </p>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {indexProducts.map((p) => (
          <div class="rounded-[var(--radius-card)] border border-border-grey bg-white p-6">
            <h3 class="text-base font-extrabold leading-tight text-charcoal">{p.name}</h3>
            <p class="mt-1 text-sm font-semibold text-f10-blue">{p.file}</p>
            <a href={p.doc} target="_blank" rel="noopener" class="mt-4 inline-block text-sm font-semibold text-f10-red hover:underline">Read the FOI Summary →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality & manufacturing -->
  <section class="bg-white">
    <div class="section-inner py-16">
      <div class="max-w-3xl">
        <span class="inline-block rounded-full bg-f10-blue/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-f10-blue">
          Quality &amp; manufacturing
        </span>
        <h2 class="mt-3 text-3xl font-extrabold">Quality &amp; manufacturing standards</h2>
        <p class="mt-3 text-charcoal">
          F10® products are manufactured by {SITE.company} under recognised quality-management and
          good-manufacturing-practice systems. Certificates are published in full.
        </p>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {qualityDocs.map((d) => (
          <div class="rounded-[var(--radius-card)] border border-border-grey bg-white p-6">
            <h3 class="text-lg font-extrabold leading-tight text-charcoal">{d.name}</h3>
            <p class="mt-1 text-sm text-medium-grey">{d.meta}</p>
            <a href={d.doc} target="_blank" rel="noopener" class="mt-4 inline-block text-sm font-semibold text-f10-red hover:underline">View the certificate →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ (GEO) -->
  <section class="dots-light">
    <div class="section-inner py-16">
      <h2 class="text-3xl font-extrabold">Credentials — questions &amp; answers</h2>
      <dl class="mt-8 grid gap-6 md:grid-cols-3">
        {faqs.map((f) => (
          <div class="rounded-[var(--radius-card)] border border-border-grey bg-white p-6">
            <dt class="text-base font-extrabold text-charcoal">{f.q}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-medium-grey">{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Distributor CTA -->
  <section class="dots-blue text-white">
    <div class="section-inner flex flex-col items-center gap-4 py-14 text-center">
      <h2 class="text-3xl font-extrabold text-white">Verified F10®. Ready to source it?</h2>
      <p class="max-w-xl text-white/90">[CONFIRM: US where-to-buy model — distributors as in SA, or a different US arrangement.]</p>
      <a href="/distributors" class="rounded-lg bg-white px-6 py-3 text-sm font-bold text-f10-blue transition hover:bg-light-blue">
        Find a distributor
      </a>
    </div>
  </section>
</BaseLayout>
