---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import OrganizationSchema from '../components/OrganizationSchema.astro';
import { SITE } from '../consts';

interface Props {
  title: string;
  description?: string;
  /** Path-relative page image for social cards, e.g. "/og/home.png" */
  image?: string;
}

const { title, description = SITE.tagline, image } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const ogImage = image ? new URL(image, Astro.site ?? SITE.url).href : undefined;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / social (og:image was missing on the old site — SEO gap fixed) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <meta name="generator" content={Astro.generator} />
    <OrganizationSchema />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
